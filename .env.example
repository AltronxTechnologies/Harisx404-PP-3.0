# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_EMAIL=itsharis.tech@gmail.com

# Contact form email delivery (generic SMTP / Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=portfolio@example.com

# Public chat: Groq primary, Gemini fallback. Keys are server-only.
GROQ_API_KEY=your_groq_api_key_here
# Optional override; default is the documented production model openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b
# Gemini also supports the existing admin AI and embeddings.
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional assistant safeguards & observability
AI_ASSISTANT_DISABLED=false
ENABLE_AI_TELEMETRY=false

# Media & Image Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Testimonial Notifications (Loops - Optional)
LOOPS_API_KEY=your_loops_api_key
LOOPS_TESTIMONIAL_TRANSACTIONAL_ID=your_loops_transactional_id

# Lighthouse Live Stats (PageSpeed API - Optional)
PAGESPEED_API_KEY=your_pagespeed_api_key

# Site Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Muhammad Haris | Full-Stack Engineer"

# Rate Limiting & Upstash Redis (Optional)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
